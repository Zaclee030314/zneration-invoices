NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only. Needed for /api/team/invite (Supabase Dashboard -> Settings -> API -> service_role).
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Enables the AI routes under /api/ai when set.
ANTHROPIC_API_KEY=
# Private server-to-server WhatsApp integration. Generate a long random secret.
WHATSAPP_INTEGRATION_SECRET=
# The Zneration workspace UUID that owns generated documents.
WHATSAPP_WORKSPACE_ID=
